# ==============================================================================
# AgroVision Backend - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' for local development:
#    cp .env.example .env   (Linux/macOS)
#    Copy-Item .env.example .env (PowerShell)
# 2. DO NOT commit your real '.env' file or production secrets to version control.
# 3. All variables below provide sensible defaults for local development.
# ==============================================================================

# Application Identity & Lifecycle
APP_NAME="AgroVision API"
APP_VERSION="0.1.0"
DEBUG=true
ENVIRONMENT="development"

# API Routing
API_V1_PREFIX="/api/v1"

# Database Configuration (PostgreSQL with Psycopg 3 driver)
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/agrovision"

# PostgreSQL Container Credentials (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agrovision
POSTGRES_PORT=5432

# JWT Authentication Configuration
# IMPORTANT: Generate a secure 32+ byte secret for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Allowed Origins
# Can be specified as a JSON array or comma-separated URLs:
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
